# Copy this file to .env and replace the placeholders on YOUR laptop.
# Use the Atlas "Drivers" connection string, but remove any embedded username/password.
MONGO_URI=mongodb+srv://YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_USERNAME=YOUR_DATABASE_USERNAME
MONGO_PASSWORD=YOUR_DATABASE_PASSWORD
# Shared class database: initial writes DISABLED; opt-in only for new WEB26 accounts and their linked marketplace data.
MONGO_DB_NAME=ecocraft
MONGO_TIMEOUT_MS=5000
FLASK_DEBUG=false

# Historical development-database option. Keep false for shared ecocraft.
# Set ENABLE_TEAM_DEMO_WRITES=true ONLY when ready to insert new test users.
ENABLE_TEAM_DEMO_WRITES=false
# Preserve the old separate-dev option, unused in our current shared-db plan.
ENABLE_DEV_WRITES=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=PASTE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXP_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enable "Upload from computer" for product photos.
# Images themselves are hosted by Cloudinary; MongoDB stores HTTPS URLs.
# Keep all three values on the server; never commit them or put them into JavaScript.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
